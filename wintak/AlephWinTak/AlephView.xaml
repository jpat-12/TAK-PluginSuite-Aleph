<UserControl x:Class="AlephWinTak.AlephView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320">
    <!-- DataContext is the AlephDockPane (WinTAK sets it); everything binds through Model. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" DataContext="{Binding Model}">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.85" />

            <TextBlock Style="{StaticResource Header}" Text="Server" />
            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="https://aleph.example.org" />
            <PasswordBox x:Name="TokenBox" Margin="0,4,0,0" PasswordChanged="OnTokenChanged"
                         ToolTip="API token from the Aleph admin page" />
            <TextBlock Text="A token is saved — leave blank to keep it." FontSize="11" Opacity="0.7"
                       Visibility="{Binding HasSavedToken, Converter={StaticResource Visible}}" />
            <Button Content="Save &amp; connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />

            <TextBlock Style="{StaticResource Header}" Text="1 · Area" />
            <ItemsControl ItemsSource="{Binding AreaOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><Button Content="{Binding Title}" Command="{Binding Select}" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding AreaLabel}" TextWrapping="Wrap" Opacity="0.85" />

            <TextBlock Style="{StaticResource Header}" Text="2 · Layers" />
            <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Margin="0,2" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ComboBox ItemsSource="{Binding Zooms}" SelectedItem="{Binding SelectedZoom}" DisplayMemberPath="Label"
                      HorizontalAlignment="Left" MinWidth="180" Margin="0,4,0,0" ToolTip="Imagery detail" />

            <TextBlock Style="{StaticResource Header}" Text="3 · Capture" />
            <TextBox Text="{Binding CaptureName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name (e.g. Sector 3)" />
            <TextBlock Text="{Binding EstimateLabel}" Opacity="0.85" Margin="0,4" />
            <Button Content="Capture area" Command="{Binding CaptureCommand}" HorizontalAlignment="Left" FontWeight="Bold" />

            <TextBlock Style="{StaticResource Header}" Text="Captures" />
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="#33808080" Padding="0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Opacity="0.85"
                                           Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                                <WrapPanel>
                                    <Button Content="{Binding DownloadLabel}" Command="{Binding Download}"
                                            Visibility="{Binding CanDownload, Converter={StaticResource Visible}}" />
                                    <Button Content="Retry" Command="{Binding RetryCommand}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource Visible}}" />
                                    <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Header}" Text="Point lookup" />
            <Button Content="Click a spot: elevation, address, photos" Command="{Binding PointCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding PointResult}" TextWrapping="Wrap" Margin="0,4" />

            <TextBlock FontSize="11" Opacity="0.6" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="Open data only: USGS NAIP imagery, AWS Terrain Tiles, © OpenStreetMap contributors, Mapillary (CC BY-SA)." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
